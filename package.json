{
  "name": "codethread",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b && tsc -p tsconfig.tools.json",
    "build": "tsc -b",
    "test": "vitest run",
    "security:check": "pnpm audit --audit-level=low",
    "bench:positions": "node scripts/benchmark-source-positions.ts",
    "bench:repository-profile": "node scripts/benchmark-repository-profile.ts",
    "demo:semantic": "node scripts/demo-semantic.ts",
    "investigate": "node scripts/investigate.ts",
    "bench:source-discovery": "node --expose-gc scripts/benchmark-source-discovery.ts",
    "demo:investigation": "node scripts/investigate.ts --demo todo",
    "demo:visual": "node scripts/investigate.ts --demo todo --view",
    "test:browser": "node tests/viewer-browser.ts",
    "eval:semantic": "node scripts/eval-semantic.ts",
    "eval:external": "node scripts/eval-external-semantic.ts",
    "study:validate": "node scripts/study.ts validate",
    "study:score": "node scripts/study.ts score",
    "study:provenance": "node scripts/study.ts provenance",
    "study:realworld": "node scripts/realworld-study.ts",
    "study:demo": "node scripts/study.ts demo",
    "arch:check": "node scripts/architecture.ts",
    "req:validate": "node scripts/requirements.ts validate",
    "req:list": "node scripts/requirements.ts list",
    "req:show": "node scripts/requirements.ts show",
    "req:context": "node scripts/requirements.ts context",
    "check": "pnpm format:check && pnpm lint && pnpm req:validate && pnpm arch:check && pnpm build && pnpm study:validate && pnpm typecheck && pnpm test",
    "backend:start": "node scripts/backend/main.ts",
    "backend:migrate": "node scripts/backend/migrate.ts",
    "backend:roles": "node scripts/backend/grant-runtime.ts",
    "backend:backup": "node scripts/backend/backup.ts",
    "backend:restore:verify": "node scripts/backend/restore-verify.ts",
    "backend:bench": "node scripts/backend/benchmark-database.ts"
  },
  "devDependencies": {
    "@codethread/code-model": "workspace:*",
    "@codethread/contracts": "workspace:*",
    "@codethread/symbol-indexer": "workspace:*",
    "@codethread/trace-engine": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "postgres": "4.1.1"
  }
}
